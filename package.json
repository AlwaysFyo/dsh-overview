{
  "name": "dsh-overview",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "DSH 全景概览插件：以工作区项目为维度的会话/任务仪表盘",
  "license": "MIT",
  "author": "AlwaysFyo",
  "keywords": ["dsh", "dsh-plugin", "deepseekruntime", "dashboard", "sessions"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlwaysFyo/dsh-overview.git"
  },
  "homepage": "https://cnb.cool/one-mugen/dsh-overview",
  "bugs": {
    "url": "https://github.com/AlwaysFyo/dsh-overview/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs",
    "snapshot": "node src/cli.ts",
    "check": "tsc -p tsconfig.json",
    "test": "node --test tests/model.test.ts tests/delete.test.ts tests/liveness.test.ts",
    "dev": "vite"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
